# 競輪予想支援CLIの環境変数サンプル
# このファイルをコピーして .env を作成し、必要な値を入れてください。
#
#   cp .env.example .env
#
# .env はGit管理から除外されます（.gitignore 参照）。
# 自動投票・購入処理は本ツールに存在しません。APIキーは予想文生成にのみ使われます。

# 既定で使うLLMプロバイダ: mock / openai / anthropic
LLM_PROVIDER=openai

# --- OpenAI ---
# https://platform.openai.com/api-keys から発行したキー
OPENAI_API_KEY=
# 例: gpt-4o-mini / gpt-4o / o4-mini など。未指定時は gpt-4o-mini を使用。
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic ---
# https://console.anthropic.com/settings/keys から発行したキー
ANTHROPIC_API_KEY=
# 例: claude-sonnet-4-6 / claude-opus-4-7 など。未指定時は claude-sonnet-4-6 を使用。
ANTHROPIC_MODEL=claude-sonnet-4-6
